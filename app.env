# Settings for swift-app-kit's setup.sh. It reads this with bash, so quote values.

APP_NAME="Tether"
BUNDLE_ID="local.tether"
SYMBOL="cable.connector"
INSTALL_NOTES="Look for the cable icon in the menu bar.

  • Click it for a brightness slider per external monitor. The brightness keys change the screen
    the pointer is on.
  • The first time, macOS asks you to allow Tether in Accessibility settings. Tether needs that
    for the brightness keys and the mouse wheel. Turn it on in System Settings → Privacy &
    Security → Accessibility.
  • Keep natural scrolling on in System Settings → Trackpad. The trackpad stays natural, and a
    mouse wheel scrolls the traditional way.
  • Tether starts automatically at login."
